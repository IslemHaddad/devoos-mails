# /etc/devops-mails/agent.env — config du worker systemd.
# Installe-le avec des permissions 0600 (contient le jeton).

# Master joint par nom de domaine (jamais par IP). Pour un worker HORS cluster,
# le port 8671 doit etre expose (Service LoadBalancer/NodePort dedie).
MASTER_URL=http://devops-mails.eadn.dz:8671

# Doit correspondre au Secret devops-mails-agent cote cluster.
AGENT_TOKEN=change-me-please

# Identite du worker (defaut : hostname).
WORKER_NAME=host-file-watcher

# Le check : exit 0 == "vrai" -> declenche l'envoi. Exemple : un fichier apparu.
CHECK_COMMAND=test -f /var/run/deploy.done
CHECK_INTERVAL=30s

# false : notifie une seule fois au front montant (faux -> vrai).
# true  : notifie a chaque check vrai.
REPEAT=false

# Email envoye par le master quand le check passe a vrai.
MAIL_TARGETS=ops@eadn.dz,oncall@eadn.dz
MAIL_SUBJECT=[deploy] le fichier marqueur est apparu
MAIL_BODY=Le fichier /var/run/deploy.done a ete cree sur l'hote.
MAIL_HTML=false
